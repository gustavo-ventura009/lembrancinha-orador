{
  "name": "lembrancinha-do-orador",
  "version": "1.0.0",
  "private": true,
  "description": "Lembrancinha do Orador — app Android (Capacitor)",
  "scripts": {
    "www": "node scripts/copiar-www.js",
    "android:preparar": "npm run www && npx cap add android && node scripts/ajustar-android.js && npx cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
